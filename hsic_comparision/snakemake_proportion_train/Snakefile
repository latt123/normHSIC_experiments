from snakemake.utils import min_version

##### set minimum snakemake version #####
min_version("6.4.1")

include: "rules/normhsic.smk"
configfile: "snakemake_proportion_train/rules/config.yml"

method_list = ['normhsic']
n_list = [128] #, 512, 2048]
d_list = [1, 2, 4]
dist_list = ['a']
scale_pi_over_four_list = [0, 0.2, 0.4, 0.6, 0.8, 1]

rule all:
    input:
        expand("results/snakemake_proportion_train/output/{method}/n_{n}_d_{d}_dist_{dist}_angle_{scale_pi_over_four}_proptrain_{proportion_train}_S_{truncation_X}_T_{truncation_e}.csv",method = method_list, n = n_list, d = d_list, dist = dist_list, scale_pi_over_four = scale_pi_over_four_list, proportion_train = config["proportion_train"], truncation_X = config["truncation_X"], truncation_e = config["truncation_e"])

# uv run snakemake --snakefile snakemake_proportion_train/Snakefile --keep-going --nolock --use-conda --cores all --rerun-triggers mtime --conda-base-path $HOME/miniforge3
