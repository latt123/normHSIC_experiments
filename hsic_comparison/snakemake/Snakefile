from snakemake.utils import min_version

##### set minimum snakemake version #####
min_version("6.4.1")

include: "rules/normhsic.smk"
include: "rules/hsic.smk"


method_list = ["normhsic", "hsic"]
n_list = [128, 512, 2048]
d_list = [1, 2, 4]
dist_list = ['a', 'b', 'c', 'g','i']
scale_pi_over_four_list = [0, 0.2, 0.4, 0.6, 0.8, 1]

rule all:
    input:
        expand("results/snakemake/output/{method}/n_{n}_d_{d}_dist_{dist}_angle_{scale_pi_over_four}.csv", method=method_list, n = n_list, d = d_list, dist = dist_list, scale_pi_over_four = scale_pi_over_four_list)


# uv run snakemake --snakefile snakemake/Snakefile --keep-going --nolock --use-conda --cores all --rerun-triggers mtime --conda-base-path $HOME/miniforge3
